INFO:root:Running with configuration: 
base_logdir: /global/scratch/users/ren27/vmcnet_logs
debug_nans: false
distribute: false
dtype: float32
eval:
  nan_safe: false
  nburn: 5000
  nchains: 2000
  nepochs: 0
  nmoves_per_width_update: 100
  nsteps_per_param_update: 10
  record_amplitudes: false
  record_local_energies: true
  std_move: 0.25
  use_data_from_training: false
initial_seed: 0
logdir: /global/scratch/users/ren27/vmcnet_logs/carbon_prelim
logging_level: INFO
model:
  backflow:
    activation_fn: tanh
    bias_init_1e_stream:
      type: normal
    bias_init_2e_stream:
      type: normal
    kernel_init_2e_1e_stream:
      scale: 1.0
      type: orthogonal
    kernel_init_2e_2e_stream:
      scale: 2.0
      type: orthogonal
    kernel_init_mixed:
      scale: 1.0
      type: orthogonal
    kernel_init_unmixed:
      scale: 2.0
      type: orthogonal
    ndense_list: !!python/tuple
    - &id001 !!python/tuple
      - 256
      - 16
    - *id001
    - *id001
    - !!python/tuple
      - 256
    one_electron_skip: true
    one_electron_skip_scale: 1.0
    two_electron_skip: true
    two_electron_skip_scale: 1.0
    use_bias: true
  bias_init_orbital_linear:
    type: normal
  envelope_softening: 0.0
  full_det: true
  include_cusp_jastrow: false
  input_streams:
    ee_norm_softening: 0.0
    ei_norm_softening: 0.0
    include_2e_stream: true
    include_ee_norm: true
    include_ei_norm: true
  isotropic_decay: true
  kernel_init_envelope_dim:
    type: ones
  kernel_init_envelope_ion:
    type: ones
  kernel_init_orbital_linear:
    scale: 2.0
    type: orthogonal
  ndeterminants: 16
  orbitals_use_bias: true
  type: ferminet
notes: Carbon atom, tuned settings from SPRING paper (arXiv:2401.10190)
problem:
  ee_softening: 0.0
  ei_softening: 0.0
  ion_charges: !!python/tuple
  - 6.0
  ion_pos: !!python/tuple
  - !!python/tuple
    - 0.0
    - 0.0
    - 0.0
  nelec: !!python/tuple
  - 4
  - 2
save_to_current_datetime_subfolder: false
subfolder_name: carbon_prelim
vmc:
  best_checkpoint_every: 100
  check_for_nans: false
  checkpoint_dir: checkpoints
  checkpoint_every: 1000
  checkpoint_variance_scale: 10
  clip_center: mean
  clip_threshold: 5.0
  nan_safe: true
  nburn: 5000
  nchains: 1000
  nepochs: 1000
  nhistory_max: 200
  nmoves_per_width_update: 100
  nsteps_per_param_update: 10
  optimizer:
    adam:
      b1: 0.9
      b2: 0.999
      eps: 1.0e-08
      eps_root: 0.0
      learning_decay_rate: 0.0001
      learning_rate: 0.05
      schedule_type: inverse_time
    gauss_newton:
      E: 0.0
      clip_threshold: 1000.0
      constrain_norm: true
      damping: 0.001
      learning_decay_rate: 0.0001
      learning_rate: 1.0
      norm_constraint: 0.001
      schedule_type: inverse_time
    kfac:
      curvature_ema: 0.95
      damping: 0.001
      estimation_mode: fisher_exact
      inverse_update_period: 1
      l2_reg: 0.0
      learning_decay_rate: 0.0001
      learning_rate: 0.05
      min_damping: 0.0001
      norm_constraint: 0.001
      register_only_generic: false
      schedule_type: inverse_time
    prime_sr:
      constrain_norm: true
      damping: 0.001
      learning_decay_rate: 0.0001
      learning_rate: 0.02
      norm_constraint: 0.001
      schedule_type: inverse_time
    same_sampled_spring_unified:
      adaptive_eta: false
      adaptive_probe: false
      constrain_norm: true
      damping: 0.001
      lb_window: 30
      learning_decay_rate: 0.0001
      learning_rate: 0.05
      mu: 0.0
      norm_constraint: 0.001
      probe_damping: 0.001
      probe_lr: -1.0
      schedule_type: inverse_time
    sgd:
      learning_decay_rate: 0.0001
      learning_rate: 0.05
      momentum: 0.0
      nesterov: false
      schedule_type: inverse_time
    spring:
      constrain_norm: true
      damping: 0.001
      learning_decay_rate: 0.0001
      learning_rate: 0.05
      mu: 0.99
      norm_constraint: 0.001
      schedule_type: inverse_time
  optimizer_type: kfac
  record_amplitudes: false
  record_param_l1_norm: false
  std_move: 0.25
wandb:
  group: default
  mode: disabled
  name: vmc-molecule_run
  project: default

